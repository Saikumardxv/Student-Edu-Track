# Root development ports and URLs
PORT=5000
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:5000

# Set this when the frontend is hosted separately from the backend.
# VITE_API_URL=https://api.example.com/api

# Optional backend CORS origin override.
# FRONTEND_URL=http://localhost:5173

# Set to false when the backend should run as API-only.
# SERVE_FRONTEND=true