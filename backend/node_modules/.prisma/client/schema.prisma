datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("STUDENT") // "ADMIN", "FACULTY", "STUDENT"
  departmentId Int?
  photo        String?
  createdAt    DateTime @default(now())
  student      Student?
  faculty      Faculty?
}

model Department {
  id         Int         @id @default(autoincrement())
  name       String
  code       String      @unique
  students   Student[]
  faculty    Faculty[]
  subjects   Subject[]
  timetables Timetable[]
}

model Semester {
  id          Int          @id @default(autoincrement())
  number      Int
  year        Int
  subjects    Subject[]
  enrollments Enrollment[]
  timetables  Timetable[]
}

model Student {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  user            User         @relation(fields: [userId], references: [id])
  rollNumber      String       @unique
  departmentId    Int
  department      Department   @relation(fields: [departmentId], references: [id])
  currentSemester Int
  enrollments     Enrollment[]
  attendances     Attendance[]
  marks           Mark[]
}

model Faculty {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  user         User         @relation(fields: [userId], references: [id])
  employeeId   String       @unique
  departmentId Int
  department   Department   @relation(fields: [departmentId], references: [id])
  subjects     Subject[]
  attendances  Attendance[]
}

model Subject {
  id             Int             @id @default(autoincrement())
  name           String
  code           String          @unique
  credits        Int
  departmentId   Int
  department     Department      @relation(fields: [departmentId], references: [id])
  semesterId     Int
  semester       Semester        @relation(fields: [semesterId], references: [id])
  facultyId      Int?
  faculty        Faculty?        @relation(fields: [facultyId], references: [id])
  enrollments    Enrollment[]
  attendances    Attendance[]
  marks          Mark[]
  timetableSlots TimetableSlot[]
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id])
  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  facultyId Int
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  date      DateTime
  status    String // "PRESENT", "ABSENT", "LATE"
}

model Mark {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  internal1 Float?
  internal2 Float?
  midterm   Float?
  external  Float?
  total     Float?
  grade     String?
}

model Timetable {
  id           Int             @id @default(autoincrement())
  departmentId Int
  department   Department      @relation(fields: [departmentId], references: [id])
  semesterId   Int
  semester     Semester        @relation(fields: [semesterId], references: [id])
  slots        TimetableSlot[]
}

model TimetableSlot {
  id          Int       @id @default(autoincrement())
  timetableId Int
  timetable   Timetable @relation(fields: [timetableId], references: [id])
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  day         String // "Monday", "Tuesday", etc.
  startTime   String
  endTime     String
  room        String?
}

model Notice {
  id           Int      @id @default(autoincrement())
  title        String
  content      String
  targetRole   String? // "ADMIN", "FACULTY", "STUDENT", or null for all
  departmentId Int?
  createdAt    DateTime @default(now())
  createdBy    Int
}
