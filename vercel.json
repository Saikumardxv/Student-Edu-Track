{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/favicon.ico",
          "destination": "/favicon.svg"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm run build",
      "entrypoint": "src/index.ts"
    }
  }
}